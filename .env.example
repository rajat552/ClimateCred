# RuralMind AI — Local Environment Variables
# Copy this file to '.env' and paste your keys. Do NOT commit the '.env' file.

# Google AI Studio API Key (for Gemini AI Mentor recommendations)
VITE_GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# OpenWeatherMap API Key (for village climate risk indicators)
VITE_OPENWEATHER_API_KEY=YOUR_WEATHER_KEY_HERE
