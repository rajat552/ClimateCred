# ============================================
# ClimateTwin — Local Environment Variables Template
# Copy this file to '.env' and paste your keys. Do NOT commit '.env'.
# ============================================

# Gemini AI Studio API Key (Server-Side Copilot)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Physical Climate Hazard Feeds)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Ports
PORT=3001
VITE_PORT=3000
CLIMATE_ENGINE_URL=http://localhost:8000
AI_COPILOT_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000
