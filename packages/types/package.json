{
  "name": "@climatetwin/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types for ClimateTwin",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@climatetwin/typescript-config": "workspace:*",
    "typescript": "^5.5.4"
  }
}
