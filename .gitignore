# ============================================
# ClimateTwin — .gitignore
# ============================================

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
.next/
out/

# Environment variables — NEVER commit
.env
.env.local
.env.production
.env.staging
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.ruff_cache/

# ML artifacts
ml/artifacts/**/*.pkl
ml/artifacts/**/*.joblib
ml/data/raw/*.csv
ml/data/raw/*.xlsx
ml/data/raw/*.zip

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Turborepo
.turbo/

# Docker volumes (local)
.postgres-data/
.minio-data/

# Test coverage
coverage/
.nyc_output/

# Playwright
playwright-report/
test-results/
